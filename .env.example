SECRET_KEY=replace-with-a-long-random-string
TOKEN_EXPIRE_MINUTES=10080
DB_PATH=calcvoyager.db
PROGRESS_DB=supabase  # when SUPABASE_URL and SUPABASE_KEY are configured, progress storage uses Supabase
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-backend-only-service-role-or-secret-key
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173,https://calculus.quantumlogiclimited.com,https://calculus.quantumlogicslimited.com,https://calculus-runtime-frontend-ten.vercel.app

# Ask Tutor: where the Calculus-AI-Chatbot repo lives (default ../Calculus-AI-Chatbot)
CHATBOT_DIR=
# The chat routes forward questions to the chatbot's aiService (holds GROQ_API_KEY)
AI_SERVICE_URL=http://127.0.0.1:8001
# Optional persistent location for chat history
CHAT_DB_PATH=

# ── Email verification (signup sends a 6-digit code + a one-click link) ──
# Where the link in the email points (your frontend). Defaults to the request's site.
FRONTEND_URL=https://calculus.quantumlogicslimited.com
# Option A — Resend (https://resend.com, free tier). Works on hosts that block SMTP.
RESEND_API_KEY=
# Option B — SMTP, e.g. Gmail with an App Password (Google Account > Security > App passwords)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Sender shown in the inbox. With Resend this must be on a domain you verified there.
EMAIL_FROM=CalcVoyager <no-reply@quantumlogicslimited.com>
# Local development only: print the code in this console instead of emailing it.
EMAIL_DEV_MODE=false
